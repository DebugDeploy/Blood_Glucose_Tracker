# Server port
PORT=4000

# PostgreSQL connection. Create the "sweety" database before running the app.
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/sweety

# Use a long, random value for your local app.
JWT_SECRET=replace-this-with-a-long-random-value

# Local website address allowed to call the API
CLIENT_ORIGIN=http://localhost:5173

# Demo account created by `npm run seed -w server`
SEED_USER_NAME=Demo User
SEED_USER_EMAIL=demo@example.com
SEED_USER_PASSWORD=DemoPassword123!

# Optional: set this in client/.env only when the API is not at /api.
# VITE_API_URL=/api
